# Copy to .env for local development (pnpm dev). Never commit real secrets.

# Shared by the API (signs) and collab servers (verify). >= 32 chars.
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
DATABASE_URL=postgres://huddle:huddle@localhost:5432/huddle
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
RUN_MIGRATIONS=true

# AI: "anthropic" uses the real API (needs ANTHROPIC_API_KEY); "mock" is a
# deterministic offline provider used by tests and keyless demos.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MONTHLY_TOKEN_BUDGET=200000

# Observability (optional)
SENTRY_DSN=
VITE_SENTRY_DSN=
METRICS_TOKEN=
